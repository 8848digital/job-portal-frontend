# Copy this file to `.env` (or `.env.local`) and fill in the values.
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle at
# build time, so never put secrets in them. Restart `npm run dev` after edits.

# Backend (Frappe) base URL — no trailing slash
NEXT_PUBLIC_API_BASE_URL=https://careersportal.8848digital.com

# Path of the job_portal SDK API method appended to the base URL
NEXT_PUBLIC_API_MANDATE_PARAMS=/api/method/job_portal.sdk.api

# Default SDK API version sent as ?version=
NEXT_PUBLIC_API_VERSION=v2

# Public URL of this frontend — used to build the reset-password link in emails
NEXT_PUBLIC_SITE_URL=https://careers.8848digital.com
